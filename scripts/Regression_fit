import json
import os

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import statsmodels.api as sm

# file paths

DATA_PATH = "./data/Single_Linear/1_D_H.csv"
OUTPUT_PATH = "./outputs/1_D_H_results"
DATASET_LABEL = "1D (High noise)"
HEADER = None

os.makedirs(OUTPUT_PATH, exist_ok=True)



# Load data
data = pd.read_csv(DATA_PATH, header=HEADER)
n_predictors = data.shape[1] - 1
x_names = [f"x{i+1}" for i in range(n_predictors)]
data.columns = x_names + ["y"]

print(f"Loaded data from {DATA_PATH}: {data.shape[0]} rows, {n_predictors} predictor(s)")

X = data[x_names]
y = data["y"]



# Fit Least Squares Regression model
X_with_const = sm.add_constant(X)  # Add constant term for intercept
model = sm.OLS(y, X_with_const).fit()

# print(model.summary())



# Metrics
fitted_values = model.fittedvalues
residuals = model.resid

metrics = {
    "dataset_label": DATASET_LABEL,
    "n_predictors": n_predictors,
    "R_squared": model.rsquared,
    "Adjusted_R_squared": model.rsquared_adj,
    "MSE": np.mean(residuals**2),
    "RMSE": np.sqrt(np.mean(residuals**2)),
    "MAE": np.mean(np.abs(residuals)),
    "resid_std_error": float(np.sqrt(model.scale)),
    "F_statistic": model.fvalue,
    "False_positive_rate": model.f_pvalue,
    "coefficients": model.params.to_dict(),
    "coef_std_errors": model.bse.to_dict()
}


# Fitted equation as readable string
equation_terms = [f"{model.params['const']:.4f}"]  # Intercept
equation_terms += [f"{model.params[name]:+.4f}*{name}" for name in x_names]

metrics["equation"] = "y = " + " ".join(equation_terms)
print("\nFitted equation:", metrics["equation"])
 
with open(os.path.join(OUTPUT_PATH, "metrics.json"), "w") as handle:
    json.dump(metrics, handle, indent=2, default=float)
 
with open(os.path.join(OUTPUT_PATH, "summary.txt"), "w") as handle:
    handle.write(str(model.summary()))



# Plotting

## Simple scatter plot with fitted line for 1 predictor
if n_predictors == 1:
    plt.figure(figsize=(8, 6))
    plt.scatter(X[x_names[0]], y, color='blue', label='Data points')
    plt.plot(X[x_names[0]], fitted_values, color='red', label='Fitted line')
    plt.xlabel(x_names[0])
    plt.ylabel('y')
    plt.title(f'Linear Regression Fit: {DATASET_LABEL}')
    plt.legend()
    plt.grid()
    plt.savefig(os.path.join(OUTPUT_PATH, "regression_plot.png"))
    plt.close()

else:

# Multiple variables:
    axes = pd.plotting.scatter_matrix(data, figsize=(9, 9), diagonal="hist")
    plt.suptitle(f"Scatter matrix - {DATASET_LABEL}", fontsize=18)
    plt.tight_layout()
    plt.savefig(os.path.join(OUTPUT_PATH, "scatter_matrix.png"))
    plt.close()


#Predicted vs actual, residuals vs fitted, Q-Q plot (works at every dimension)
fig, axes = plt.subplots(1, 3, figsize=(16, 4.8))
 
axes[0].scatter(y, fitted_values)
lims = [min(y.min(), fitted_values.min()), max(y.max(), fitted_values.max())]
axes[0].plot(lims, lims, color="red")           # perfect-prediction line
axes[0].set_xlabel("Actual y", fontsize=14)
axes[0].set_ylabel("Predicted y", fontsize=14)
axes[0].set_title("Predicted vs actual", fontsize=15)
axes[0].grid(alpha=0.5)
 
axes[1].scatter(fitted_values, residuals)
axes[1].axhline(0, color="red")
axes[1].set_xlabel("Fitted y", fontsize=14)
axes[1].set_ylabel("Residual", fontsize=14)
axes[1].set_title("Residuals vs fitted", fontsize=15)
axes[1].grid(alpha=0.5)
 
sm.qqplot(residuals, line="s", ax=axes[2])
axes[2].set_title("Q-Q plot of residuals", fontsize=15)
axes[2].grid(alpha=0.5)
 
fig.suptitle(f"Regression diagnostics - {DATASET_LABEL}", fontsize=18)
fig.tight_layout()
fig.savefig(os.path.join(OUTPUT_PATH, "diagnostics.png"))
plt.close(fig)



# Partial regression plots for each predictor (only for 2 or more predictors)
if n_predictors > 1:
    fig = plt.figure(figsize=(5 * n_predictors, 4.5))
    sm.graphics.plot_partregress_grid(model, fig=fig)
    fig.suptitle(f"Partial regression - {DATASET_LABEL}", fontsize=18)
    fig.tight_layout()
    fig.savefig(os.path.join(OUTPUT_PATH, "partial_regression.png"))
    plt.close(fig)
 
print(f"\nSaved results to {OUTPUT_PATH}")